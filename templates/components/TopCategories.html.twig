<div {{ attributes }}>
    {# Categories #}
    {% if this.topCategories is not empty %}
        <h5 class="mb-3">{{ 'blogs_sidebar.categories'|trans({}, 'text') }}</h5>

        <div class="list-group mb-4">
            {% for category in this.topCategories %}
                <a class="list-group-item list-group-item-action"
                   href="{{ path('blog.category', {'slug': category[0].slug}) }}">
                    {{ category[0].title|strip_words(4) }}
                    <span class="badge bg-secondary">{{ category.blogCount }}</span>
                </a>
            {% endfor %}
        </div>

    {% endif %}
</div>
