<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    {% block full_title %}
        <title>{% block title %}{% endblock %} | {{ 'site_title'|trans({}, 'text') }}</title>
    {% endblock %}

    {% block manifest %}
        <link rel="manifest" href="{{ path('manifest.manifest_content') }}">
    {% endblock %}

    {% block favicon %}
        <link rel="icon" type="image/svg+xml" sizes="any" href="{{ asset('build/images/logo.svg') }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('build/images/logo.svg') }}">
        <link rel="mask-icon" href="{{ asset('build/images/logo.svg') }}" color="#ffffff">
        <link rel="shortcut icon" href="{{ asset('build/images/logo.svg') }}"/>
    {% endblock %}

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
          integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
          crossorigin="anonymous" referrerpolicy="no-referrer"/>

    <meta name="msapplication-TileColor" content="#fff">
    <meta name="msapplication-TileImage" content="{{ asset('build/images/logo.svg') }}">
    <meta name="theme-color" content="#ffffff">

    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">

    {% block turbo %}
        <meta name="turbo-cache-control" content="no-preview">
    {% endblock %}

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}

    {% block jsonld %}
        {% block seo_organization %}{% endblock %}
    {% endblock %}

</head>
<body {{ stimulus_controller('onscroll') }}>

{% block header %}
    {% include 'partials/header.html.twig' %}
{% endblock %}

<main>
    {% block breadcrumbs %}
        <div class="breadcrumbs">
            <div class="container mb-3 pt-4">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h1>{% block headline %}{% endblock %}</h1>
                        {{ wo_render_breadcrumbs() }}
                    </div>
                    <div class="col-lg-4">
                        {% block pageSelector %}{% endblock %}
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}

    {% block content %}{% endblock %}

    <div id="flash-messages" class="flash-messages"></div>
    {% include '@LexioAdmin/flash.stream.html.twig' %}
</main>

<footer class="py-5 mt-5">
    {% block footer %}
        {# Footer html and structure comes here... #}
    {% endblock %}
</footer>

</body>
</html>

