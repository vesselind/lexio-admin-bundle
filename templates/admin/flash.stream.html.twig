{# Canonical flash stream for the reusable admin UI. #}
{% for message in app.flashes('success') %}
<turbo-stream action="append" target="flash-messages">
    <template>
        <div class="flash-message shadow-sm alert alert-success position-relative d-flex gap-2" data-controller="flash-message">
            <div>
                {{ ux_icon('fa6-solid:circle-check', {width: '1em', height: '1em', class: 'text-success'}) }}
                {{ message }}
            </div>
            <button type="button" class="bg-transparent text-decoration-none border-0" data-action="flash-message#close">
                {{ ux_icon('fa6-solid:xmark', {width: '1em', height: '1em'}) }}
            </button>
            <div class="timer bg-success" data-flash-message-target="timer"></div>
        </div>
    </template>
</turbo-stream>
{% endfor %}

{% for message in app.flashes('error') %}
    <turbo-stream action="append" target="flash-messages">
        <template>
            <div class="flash-message alert alert-danger position-relative d-flex gap-2" data-controller="flash-message">
                <div>
                    {{ ux_icon('fa6-solid:circle-xmark', {width: '1em', height: '1em', class: 'text-danger'}) }}
                    {{ message }}
                </div>
                <button type="button" class="bg-transparent text-decoration-none border-0" data-action="flash-message#close">
                    {{ ux_icon('fa6-solid:xmark', {width: '1em', height: '1em'}) }}
                </button>
                <div class="timer bg-danger" data-flash-message-target="timer"></div>
            </div>
        </template>
    </turbo-stream>
{% endfor %}
