{% extends '@LexioAdmin/admin/base_crud/listing.html.twig' %}
{# @var title string #}
{# @var listingContext \Lexio\AdminBundle\AdminCore\Listing\ListingContext #}
{# @var entityFqcn string #}
{# @var adminUrlGenerator \Lexio\AdminBundle\AdminCore\AdminUrlGenerator #}
{# @var filtersForm null|App\Form\Filter\BaseFilterType #}

{# @var items \Lexio\AdminBundle\Contract\File\ImageEntityInterface[] #}

{% block page_actions %}
    <div class="d-inline">
        <form action="{{ path('admin.image.upload') }}" method="post" enctype="multipart/form-data"
                {{ stimulus_controller('file-upload-form') }}>
            <input type="file" name="file" hidden
                    {{ stimulus_target('file-upload-form', 'input') }}
                    {{ stimulus_action('file-upload-form', 'submitForm', 'change') }}
            >
            <button
                    type="button"
                    class="btn btn-success"
                    {{ stimulus_action('file-upload-form', 'selectFile', 'click') }}
            >
                <i class="fa fa-upload" {{ stimulus_target('file-upload-form', 'icon') }}></i>
                <span class="spinner-border spinner-border-sm d-none"
                      aria-hidden="true" {{ stimulus_target('file-upload-form', 'spinner') }}></span>
                {{ 'button.upload_image'|trans({}, 'admin') }}
            </button>
        </form>
    </div>

{% endblock %}

{% block table %}
    <div class="d-flex justify-content-end mb-4">
        <div class="btn-group" role="group" aria-label="Image gallery sorting">
            {% set sort = app.request.query.get('sort') %}
            {% set order = app.request.query.get('order') %}

            <a href="{{ path('admin.image.index', {'sort': 'id', 'order': 'desc'}) }}"
               class="btn btn-primary {{ sort == 'id' and order == 'desc' ? 'active' }}">
                {{ ux_icon('tabler:sort-descending', {height: '16px', width: '16px', 'aria-hidden': true}) }} {{ 'filter.newest'|trans({}, 'admin') }}
            </a>
            <a href="{{ path('admin.image.index', {'sort': 'id', 'order': 'asc'}) }}"
               class="btn btn-primary {{ sort == 'id' and order == 'asc' ? 'active' }}">
                {{ ux_icon('tabler:sort-ascending', {height: '16px', width: '16px', 'aria-hidden': true}) }} {{ 'filter.oldest'|trans({}, 'admin') }}
            </a>
            <a href="{{ path('admin.image.index', {'sort': 'name', 'order': 'asc'}) }}"
               class="btn btn-primary  {{ sort == 'name' and order == 'asc' ? 'active' }}">
                {{ ux_icon('lsicon:sort-a-to-z-filled', {height: '23px', width: '23px', 'aria-hidden': true}) }}
            </a>
            <a href="{{ path('admin.image.index', {'sort': 'name', 'order': 'desc'}) }}"
               class="btn btn-primary {{ sort == 'name' and order == 'desc' ? 'active' }}">
                {{ ux_icon('lsicon:sort-z-to-a-filled', {height: '23px', width: '23px', 'aria-hidden': true}) }}
            </a>
        </div>
    </div>

    <div class="row">
        {% for item in items %}
            <div class="col-lg-3">
                <div class="card mb-4">
                    <div class="card-img-top rounded-top d-flex align-items-center justify-content-center overflow-hidden bg-light" style="height: 200px;">
                        <twig:Img src="{{ item.filePath }}" width="300" height="200" class="rounded-top" style="width: 100%; object-fit: contain;"></twig:Img>
                    </div>
                    <div class="card-body">
                        <h6 class="card-title">{{ item.name }}</h6>
                    </div>
                    <div class="card-footer d-flex align-items-center">
                        <div class="small">
                            <i class="fa fa-calendar-alt"></i> {{ item.createdAt|formatted_date }}
                        </div>
                        <div class="btn-group ms-auto">
                            <button type="button" class="btn btn-gray btn-sm dropdown-toggle" data-bs-toggle="dropdown"
                                    aria-expanded="true">
                                <i class="fa fa-cog"></i>
                                {{ 'button.select'|trans({}, 'admin') }}
                            </button>
                            <div class="dropdown-menu dropdown-menu-end" {{ stimulus_controller('clipboard') }}>
                                <button class="dropdown-item" {{ stimulus_action('clipboard', 'copy') }}>
                                    <i class="fa fa-copy me-1"></i> {{ 'button.copy_url'|trans({}, 'admin') }}
                                    <input type="hidden"
                                           value="{{ item.filePath }}" {{ stimulus_target('clipboard', 'source') }}>
                                </button>
                                <a class="dropdown-item" data-turbo="false" href="{{ path('admin.image.download', {'id': item.id}) }}">
                                    <i class="fa fa-download"></i> {{ 'button.download'|trans({}, 'admin') }}
                                </a>

                                <button class="dropdown-item text-danger" data-bs-toggle="modal"
                                        data-bs-target="#confirmationModal_{{ item.id }}">
                                    <i class="fa fa-remove me-1"></i> {{ 'button.delete'|trans({}, 'admin') }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                {% component 'ConfirmationModal' with {
                    subjectId: item.id,
                    navigateToUrl: path('admin.image.delete', {'id': item.id})
                } %}
                    {% block modal_body %}
                        {{ 'delete_image.confirmation_text'|trans({}, 'admin') }}
                    {% endblock %}
                {% endcomponent %}
            </div>
        {% endfor %}
    </div>
{% endblock %}
