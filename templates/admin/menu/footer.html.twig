{% extends '@LexioAdmin/admin_base.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin.menu.footer_create') }}" class="btn btn-success">
        {{ ux_icon('fa6-solid:plus', {width: '1em', height: '1em'}) }} {{ 'button.add'|trans({}, 'admin') }}
    </a>
{% endblock %}

{% block heading %}
    {{ title }}
{% endblock %}

{% block breadcrumbs %}
    {{ wo_render_breadcrumbs() }}
{% endblock %}

{# The main page content block #}
{% block content %}
    <section class="row">
        <div class="col-md-12">
            <form action="{{ path('admin.menu.footer_update_order') }}" method="POST">
                <div {{ stimulus_controller('sortable', { updatePositionUrl: path('admin.menu.footer_update_order'), flashUrl: path(lexio_admin_ui.routes.flash)}) }}>
                    {% for menu in footerMenu %}
                        {# @var menu \Lexio\AdminBundle\Entity\FooterMenu #}

                        <div data-id="{{menu.id}}">
                            <div class="card rounded mb-2">
                                <div class="card-body py-1 d-flex align-items-center">
                                    {{ ux_icon('fa6-solid:up-down', {width: '1em', height: '1em', class: 'me-2'}) }}
                                    {{ menu.title }}
                                    <input type="hidden" name="sortedItems[]" value="{{ menu.id }}">
                                    <div class="ms-auto">
                                    <a class="me-3 btn btn-secondary btn-sm" title="{{ 'button.update'|trans({}, 'admin') }}"
                                           href="{{ path('admin.menu.footer_update', {id: menu.id}) }}">{{ ux_icon('fa6-solid:pen-to-square', {width: '1em', height: '1em', class: 'mx-2'}) }}</a>
                                    </div>
                                    <form
                                            action="{{ path('admin.menu.footer_delete', {id: menu.id}) }}"
                                            method="post"
                                            onsubmit="return window.confirm('{{ 'delete_record.confirmation_text'|trans({}, 'admin')|e('js') }}')"
                                    >
                                        <button type="submit" class="btn btn-danger btn-sm" title="{{ 'button.delete'|trans({}, 'admin') }}">
                                            {{ ux_icon('fa6-solid:trash', {width: '1em', height: '1em', class: 'mx-2'}) }}
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <div {{ stimulus_controller('sortable', { updatePositionUrl: path('admin.menu.footer_update_order'), flashUrl: path(lexio_admin_ui.routes.flash)}) }}>
                            {% if menu.children is not empty %}
                                {% for item in menu.children %}
                                    <div data-id="{{ item.id }}" class="ms-5 card rounded mb-2" >
                                        <div class="card-body d-flex align-items-center py-1">
                                            {{ ux_icon('fa6-solid:up-down', {width: '1em', height: '1em', class: 'me-2'}) }}
                                            {{ item.title }}
                                            <div class="ms-auto">
                                            <a class="me-3 btn btn-secondary btn-sm" title="{{ 'button.update'|trans({}, 'admin') }}"
                                                   href="{{ path('admin.menu.footer_update', {id: item.id}) }}">{{ ux_icon('fa6-solid:pen-to-square', {width: '1em', height: '1em', class: 'mx-2'}) }}</a>
                                            </div>
                                            <form
                                                    action="{{ path('admin.menu.footer_delete', {id: item.id}) }}"
                                                    method="post"
                                                    onsubmit="return window.confirm('{{ 'delete_record.confirmation_text'|trans({}, 'admin')|e('js') }}')"
                                            >
                                                <button type="submit" class="btn btn-danger btn-sm" title="{{ 'button.delete'|trans({}, 'admin') }}">
                                                    {{ ux_icon('fa6-solid:trash', {width: '1em', height: '1em', class: 'mx-2'}) }}
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                            </div>
                        </div>

                    {% else %}
                        <div>{{ 'menu.no_items'|trans({}, 'admin') }}</div>
                    {% endfor %}
                </div>
            </form>
        </div>
    </section>

{% endblock %}
