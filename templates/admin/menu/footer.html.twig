{% extends '@LexioAdmin/admin_base.html.twig' %}
{% block title %}{{ title }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin.menu.footer_create') }}" class="btn btn-success">
        <i class="fa fa-plus"></i> {{ 'button.add'|trans({}, lexio_admin_ui.translation_domain) }}
    </a>
{% endblock %}

{% block heading %}
    {{ title }}
{% endblock %}

{% block breadcrumbs %}
    {{ wo_render_breadcrumbs() }}
{% endblock %}

{# The main page content block #}
{% block content %}
    <section class="row">
        <div class="col-md-12">
            <form action="{{ path('admin.menu.footer_update_order') }}" method="POST">
                <div {{ stimulus_controller('sortable', { updatePositionUrl: path('admin.menu.footer_update_order'), flashUrl: path(lexio_admin_ui.routes.flash)}) }}>
                    {% for menu in footerMenu %}
                        {# @var menu \Lexio\AdminBundle\Entity\FooterMenu #}

                        <div data-id="{{menu.id}}">
                            <div class="card rounded mb-2">
                                <div class="card-body py-1 d-flex align-items-center">
                                    <i class="fa fa-arrows-v me-2"></i>
                                    {{ menu.title }}
                                    <input type="hidden" name="sortedItems[]" value="{{ menu.id }}">
                                    <div class="ms-auto">
                                    <a class="me-3 btn btn-secondary btn-sm" title="{{ 'button.update'|trans({}, lexio_admin_ui.translation_domain) }}"
                                           href="{{ path('admin.menu.footer_update', {id: menu.id}) }}"><i class="fa fa-edit mx-2"></i></a>
                                    </div>
                                    <form
                                            action="{{ path('admin.menu.footer_delete', {id: menu.id}) }}"
                                            method="post"
                                            onsubmit="return window.confirm('{{ 'delete_record.confirmation_text'|trans({}, lexio_admin_ui.translation_domain)|e('js') }}')"
                                    >
                                        <button type="submit" class="btn btn-danger btn-sm" title="{{ 'button.delete'|trans({}, lexio_admin_ui.translation_domain) }}">
                                            <i class="fa fa-trash mx-2"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <div {{ stimulus_controller('sortable', { updatePositionUrl: path('admin.menu.footer_update_order'), flashUrl: path(lexio_admin_ui.routes.flash)}) }}>
                            {% if menu.children is not empty %}
                                {% for item in menu.children %}
                                    <div data-id="{{ item.id }}" class="ms-5 card rounded mb-2" >
                                        <div class="card-body d-flex align-items-center py-1">
                                            <i class="fa fa-arrows-v me-2"></i>
                                            {{ item.title }}
                                            <div class="ms-auto">
                                            <a class="me-3 btn btn-secondary btn-sm" title="{{ 'button.update'|trans({}, lexio_admin_ui.translation_domain) }}"
                                                   href="{{ path('admin.menu.footer_update', {id: item.id}) }}"><i class="fa fa-edit mx-2"></i></a>
                                            </div>
                                            <form
                                                    action="{{ path('admin.menu.footer_delete', {id: item.id}) }}"
                                                    method="post"
                                                    onsubmit="return window.confirm('{{ 'delete_record.confirmation_text'|trans({}, lexio_admin_ui.translation_domain)|e('js') }}')"
                                            >
                                                <button type="submit" class="btn btn-danger btn-sm" title="{{ 'button.delete'|trans({}, lexio_admin_ui.translation_domain) }}">
                                                    <i class="fa fa-trash mx-2"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                            </div>
                        </div>

                    {% else %}
                        <div>{{ 'menu.no_items'|trans({}, lexio_admin_ui.translation_domain) }}</div>
                    {% endfor %}
                </div>
            </form>
        </div>
    </section>

{% endblock %}
