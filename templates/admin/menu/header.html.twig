{% extends '@LexioAdmin/admin_base.html.twig' %}
{% block title %}{{ 'admin.menu.header'|trans({}, 'admin') }}{% endblock %}
{% block heading %}
    {{ 'admin.menu.header'|trans({}, 'admin') }}
{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin.menu.header_create') }}" class="btn btn-success">
        <i class="fa fa-plus"></i> {{ 'button.add'|trans({}, 'admin') }}
    </a>
{% endblock %}

{% block breadcrumbs %}
    {{ wo_render_breadcrumbs() }}
{% endblock %}

{# The main page content block #}
{% block content %}
    <section class="row">
        <div class="col-md-12">
            <form action="{{ path('admin.menu.header_update_order') }}" method="POST">
                <div {{ stimulus_controller('sortable', { updatePositionUrl: path('admin.menu.header_update_order')}) }}>
                    {% for menu in headerMenu %}
                        {# @var menu \App\Entity\HeaderMenu #}

                        <div data-id="{{menu.id}}">
                            <div class="card rounded mb-2">
                                <div class="card-body py-1 d-flex align-items-center">
                                    <i class="fa fa-arrows-v me-2"></i>
                                    {{ menu.title }}
                                    <input type="hidden" name="sortedItems[]" value="{{ menu.id }}">
                                    <div class="ms-auto">
                                        <a class="me-3 btn btn-secondary btn-sm" title="Редакция"
                                           href="{{ path('admin.menu.header_update', {id: menu.id}) }}"><i class="fa fa-edit mx-2"></i></a>
                                    </div>
                                    <form
                                            action="{{ path('admin.menu.header_delete', {id: menu.id}) }}"
                                            method="post"
                                            {{ stimulus_controller('submit-confirm', {
                                                text: 'Изтриване на записа?'
                                            }) }}
                                            {{ stimulus_action('submit-confirm', 'onSubmit') }}
                                    >
                                        <button type="submit" class="btn btn-danger btn-sm" title="Изтриване">
                                            <i class="fa fa-trash mx-2"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                            <div {{ stimulus_controller('sortable', { updatePositionUrl: path('admin.menu.header_update_order')}) }}>
                            {% if menu.children is not empty %}
                                {% for item in menu.children %}
                                    <div data-id="{{ item.id }}" class="ms-5 card rounded mb-2" >
                                        <div class="card-body d-flex align-items-center py-1">
                                            <i class="fa fa-arrows-v me-2"></i>
                                            {{ item.title }}
                                            <div class="ms-auto">
                                                <a class="me-3 btn btn-secondary btn-sm" title="Редакция"
                                                   href="{{ path('admin.menu.header_update', {id: item.id}) }}"><i class="fa fa-edit mx-2"></i></a>
                                            </div>
                                            <form
                                                    action="{{ path('admin.menu.header_delete', {id: item.id}) }}"
                                                    method="post"
                                                    {{ stimulus_controller('submit-confirm', {
                                                        text: 'Изтриване на записа?'
                                                    }) }}
                                                    {{ stimulus_action('submit-confirm', 'onSubmit') }}
                                            >
                                                <button type="submit" class="btn btn-danger btn-sm " title="Изтриване">
                                                    <i class="fa fa-trash mx-2"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                            </div>
                        </div>

                    {% else %}
                        <div>
                            No menus
                        </div>
                    {% endfor %}
                </div>
            </form>
        </div>
    </section>

{% endblock %}
