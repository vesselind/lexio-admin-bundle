{% extends '@LexioAdmin/admin/base_crud/form.html.twig' %}

{% block content %}

    {% set requested_frame = app.request.headers.get('Turbo-Frame') %}
    {% set content_frame = requested_frame and requested_frame != 'main-form' ? requested_frame : 'main-form-content' %}

    <div class="col-12">
        <turbo-frame id="main-tabs">
        </turbo-frame>

        <turbo-frame id="main-form" data-turbo-action="advance">
            {% block main_form %}

                {% if formContext.showLocalesTab and formContext.entityInstance.id %}
                    <ul class="tabs">
                        {% for locale in formContext.locales %}
                            <li class="tab">
                                <a class="{% if locale == formContext.currentLocale %}tab-active{% endif %}"
                                   href="{{ formContext.links.updateLink(locale) }}">{{ locale }}</a></li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <turbo-frame id="{{ content_frame }}">
                    {% block main_form_content %}
                        {{ parent() }}
                    {% endblock %}
                </turbo-frame>
            {% endblock %}
        </turbo-frame>
    </div>
{% endblock %}
