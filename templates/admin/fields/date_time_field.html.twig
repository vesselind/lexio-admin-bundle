{# @var column \App\AdminCore\Listing\Column #}
{# @var field \App\AdminCore\Listing\Fields\DateTimeField #}

<span class="badge bg-{{ field.badgeColor }}-subtle border border-{{ field.badgeColor }} text-{{ field.badgeColor }}"><i class="fa fa-calendar me-1"></i>
    {% if field.dateOnly %}
        {{ field.value|formatted_date }}
    {% else %}
        {{ field.value|formatted_datetime }}
    {% endif %}
</span>
