{# @var column \App\AdminCore\Listing\Column #}
{# @var field \App\AdminCore\Listing\Fields\DateTimeField #}

<span class="badge bg-{{ field.badgeColor }}-subtle border border-{{ field.badgeColor }} text-{{ field.badgeColor }}">{{ ux_icon('fa6-solid:calendar', {width: '1em', height: '1em', class: 'me-1'}) }}
    {% if field.dateOnly %}
        {{ field.value|formatted_date }}
    {% else %}
        {{ field.value|formatted_datetime }}
    {% endif %}
</span>
