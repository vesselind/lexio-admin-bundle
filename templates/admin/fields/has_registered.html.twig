{# @var entityInstance \App\Entity\WaitingList #}
{# @var column \App\AdminCore\Listing\Column #}
{# @var field \App\AdminCore\Listing\Fields\HasRegisteredField #}

{% if field.registered(entityInstance.email) %}
    <span class="badge bg-success text-white">{{ ux_icon('fa6-solid:check', {width: '1em', height: '1em'}) }}</span>
{% else %}
    <span class="badge bg-danger text-white">{{ ux_icon('fa6-solid:xmark', {width: '1em', height: '1em'}) }}</span>
{% endif %}
