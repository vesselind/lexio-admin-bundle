{# @var column \App\AdminCore\Listing\Column #}
{# @var field \App\AdminCore\Listing\Fields\StripeInvoiceUrlField #}

{% if field.value %}
<div class="badge bg-info-subtle border border-info text-success">
    <a href="{{ field.value }}" target="_blank">Stripe {{ ux_icon('fa6-solid:link', {width: '1em', height: '1em'}) }}</a>
</div>
{% else %}
    <span class="text-muted">n/a</span>
{% endif %}