
{# @var column \App\AdminCore\Listing\Column #}
{# @var field \App\AdminCore\Listing\Fields\AiQuestion #}

<div>
    <strong>{{ field.value }}</strong>
    {% if field.entityInstance.isFavourite %}
        <i class="fa fa-star text-warning" {{ stimulus_controller('tooltip', {title: 'tooltip.favourite'|trans({}, 'admin')}) }}></i>
    {% else %}
        <i class="fa-regular fa-star text-secondary-emphasis" {{ stimulus_controller('tooltip', {title: 'tooltip.not_favourite'|trans({}, 'admin')}) }}></i>
    {% endif %}
</div>
<div class="mt-1">
    <span class="fst-italic">{{ field.entityInstance.question }}</span>
</div>

{% if field.entityInstance.tags is not empty %}
<div class="mt-1">
    {% for tag in field.entityInstance.tags %}
        <span class="badge bg-secondary"><i class="fa fa-tag"></i> {{ tag.name }}</span>
    {% endfor %}
</div>
{% endif %}
