
{# @var column \App\AdminCore\Listing\Column #}
{# @var field \App\AdminCore\Listing\Fields\AiQuestion #}

<div>
    <strong>{{ field.value }}</strong>
    {% if field.entityInstance.isFavourite %}
        <span {{ stimulus_controller('tooltip', {title: 'tooltip.favourite'|trans({}, 'admin')}) }}>{{ ux_icon('fa6-solid:star', {width: '1em', height: '1em', class: 'text-warning'}) }}</span>
    {% else %}
        <span {{ stimulus_controller('tooltip', {title: 'tooltip.not_favourite'|trans({}, 'admin')}) }}>{{ ux_icon('fa6-regular:star', {width: '1em', height: '1em', class: 'text-secondary-emphasis'}) }}</span>
    {% endif %}
</div>
<div class="mt-1">
    <span class="fst-italic">{{ field.entityInstance.question }}</span>
</div>

{% if field.entityInstance.tags is not empty %}
<div class="mt-1">
    {% for tag in field.entityInstance.tags %}
        <span class="badge bg-secondary">{{ ux_icon('fa6-solid:tag', {width: '1em', height: '1em'}) }} {{ tag.name }}</span>
    {% endfor %}
</div>
{% endif %}
