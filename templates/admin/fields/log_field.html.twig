{# @var column \App\AdminCore\Listing\Column #}
{# @var field \App\AdminCore\Listing\Fields\CollectionField #}

{% set data = field.value|default([]) %}
{% set data = field.value|slice(0, 4) %}

{% for key, value in data %}
    <div class="row">
        <div class="col-4">{{ key }}</div>
        <div class="col-8">{{ value.new }}</div>
    </div>
{% else %}
    <span class="badge bg-secondary text-dark-emphasis">n/a</span>
{% endfor %}