{# @var column \App\AdminCore\Listing\Column #}
{# @var field \App\AdminCore\Listing\Fields\TokensUsageField #}

{% if field.entityInstance.model %}
<div class="badge bg-dark mb-2">{{ field.entityInstance.model.value }}</div>
{% endif %}
<div class="mb-2">
    <span class="badge bg-secondary mb-1" {{ stimulus_controller('tooltip', {'title': 'tooltip.input_tokens'|trans({}, lexio_admin_ui.translation_domain)}) }}>{{ field.inputTokens|number_format(0, null, ' ') }}</span>
    <span class="badge bg-secondary">{{ field.entityInstance.inputTokensPrice|number_format(2, ',') }} $</span>
</div>

<div class="mb-2">
    <span class="badge bg-warning mb-1" {{ stimulus_controller('tooltip', {'title': 'tooltip.output_tokens'|trans({}, lexio_admin_ui.translation_domain)}) }}>{{ field.outputTokens|number_format(0, null, ' ') }}</span>
    <span class="badge bg-warning">{{ field.entityInstance.outputTokensPrice|number_format(2, ',') }} $</span>
</div>
