<turbo-frame id="base-modal-body">

    <h2 class="h4">{{ notification.title }}</h2>
    <div class="my-2">
        <span class="badge bg-{{ notification.level.color }}"> {{ notification.level.translationKey|trans({}, 'admin') }}</span>
    </div>
    <div class="my-3">{{ notification.content|raw }}</div>

    <div class="mt-3 d-flex justify-content-end">
        <button type="button" class="btn btn-secondary"
                data-bs-dismiss="modal">{{ 'button.close'|trans({}, 'admin') }}</button>
    </div>
</turbo-frame>
