<turbo-frame id="main-form">
    {% block main_form %}
    <turbo-frame id="main-form-content">
    {% block main_form_content %}
    <div class="card">
        <div class="card-body">

            <div class="p-sm-1 p-md-3 rounded bg-white">
                <form class="mt-2 p-2" action="{{ path('admin.user.roles', {id: user.id}) }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin.user.roles.' ~ user.id) }}">
                    {% block role_choices %}
                    {% for role in roles %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="{{ role.value }}" id="{{ role.value }}"
                                   name="roles[]"
                                   {% if role.value in user.roles %}checked{% endif %}>
                            <label class="form-check-label"
                                   for="{{ role.value }}">{{ (role.translationKey|default(role.value))|trans({}, 'admin') }}</label>
                        </div>
                    {% endfor %}
                    {% endblock %}

                    <div class="divider my-4"></div>
                    <div class="d-flex justify-content-end align-items-center gap-2">
                        <a href="{{ path('admin.user.index') }}" data-turbo-frame="_top"
                           class="btn btn-secondary">{{ 'button.cancel'|trans({}, 'admin') }}</a>
                        <button class="btn btn-primary">
                            {{ ux_icon('fa6-solid:floppy-disk', {'class': 'me-1', 'height': '1em', 'width': '1em'}) }}
                            {{ 'button.save'|trans({}, 'admin') }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    {% include '@LexioAdmin/admin/flash.stream.html.twig' %}
    {% endblock %}
    </turbo-frame>
    {% endblock %}
</turbo-frame>
